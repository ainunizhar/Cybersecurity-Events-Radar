table Date
	dataCategory: Time
	lineageTag: d31c4a22-7a4f-514c-918e-33dea217cf3a

	column Date
		dataType: dateTime
		formatString: dd mmm yyyy
		isKey
		lineageTag: a1ea185c-6de8-5b73-8047-c1a51db6cee0
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: ac93cd17-3957-5c1c-a422-9da77dc71637
		summarizeBy: none
		sourceColumn: Year

	column 'Month No'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 17f55544-5b37-56f0-9d7c-3cbbe83694da
		summarizeBy: none
		sourceColumn: Month No

	column Month
		dataType: string
		lineageTag: 72484a9a-c044-563d-975d-0c63dc544b4d
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: 'Month No'

	column 'Year Month Key'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: aac38c58-a58a-57f2-ae98-cf28f582da6c
		summarizeBy: none
		sourceColumn: Year Month Key

	column 'Year Month'
		dataType: string
		lineageTag: 1b7e8ea0-1af2-55d9-bf4b-094e4bfd8410
		summarizeBy: none
		sourceColumn: Year Month
		sortByColumn: 'Year Month Key'

	column Day
		dataType: int64
		formatString: 0
		lineageTag: c7972f36-772e-5ca4-a195-fefcbeeb175e
		summarizeBy: none
		sourceColumn: Day

	partition Date = m
		mode: import
		source =
				let
				    StartDate = #date(2025, 1, 1),
				    EndDate = #date(2027, 12, 31),
				    Dates = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1, 0, 0, 0)),
				    AsTable = Table.FromList(Dates, Splitter.SplitByNothing(), {"Date"}),
				    Typed = Table.TransformColumnTypes(AsTable, {{"Date", type date}}),
				    AddYear = Table.AddColumn(Typed, "Year", each Date.Year([Date]), Int64.Type),
				    AddMonthNo = Table.AddColumn(AddYear, "Month No", each Date.Month([Date]), Int64.Type),
				    AddMonth = Table.AddColumn(AddMonthNo, "Month", each Date.ToText([Date], [Format = "MMMM", Culture = "en-GB"]), type text),
				    AddKey = Table.AddColumn(AddMonth, "Year Month Key", each Date.Year([Date]) * 100 + Date.Month([Date]), Int64.Type),
				    AddYearMonth = Table.AddColumn(AddKey, "Year Month", each Date.ToText([Date], [Format = "MMM yyyy", Culture = "en-GB"]), type text),
				    AddDay = Table.AddColumn(AddYearMonth, "Day", each Date.Day([Date]), Int64.Type)
				in
				    AddDay

	annotation PBI_ResultType = Table
