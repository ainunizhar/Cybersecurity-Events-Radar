		sourceColumn: Date Precision Label

	partition Events = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(DataFolder & "events.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"Start Date", "End Date"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Event", type text}, {"Dataset", type text}, {"Market", type text}, {"Category", type text}, {"Country", type text}, {"City", type text}, {"Venue", type text}, {"Start (as written)", type text}, {"End (as written)", type text}, {"Year", type text}, {"Event Type", type text}, {"Focus", type text}, {"Organiser", type text}, {"Scale / Audience", type text}, {"MSSP Relevance", type text}, {"Source URL", type text}, {"Verification", type text}, {"Start Date", type date}, {"End Date", type date}, {"Date Precision", type text}, {"Date Status", type text}}, "en-US"),

				    Label = Table.AddColumn(Typed, "Date Precision Label", each if [Date Precision] = "day" then "Exact day" else if [Date Precision] = "month" then "Month only" else if [Date Precision] = "year" then "Year only" else "No date yet", type text)
				in
				    Label

	annotation PBI_ResultType = Table
