	column 'Start Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: da691b24-4ccd-5d0a-97a4-3826d3e9e716
		summarizeBy: none
		sourceColumn: Start Date

		annotation UnderlyingDateTimeDataType = Date

	column 'End Date'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: e740d3f7-e8ef-5512-98c9-be8f9b10900c
