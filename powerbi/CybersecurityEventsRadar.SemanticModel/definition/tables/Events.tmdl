table Events
	lineageTag: 2fb7bf52-d76b-5395-8fbb-bd8020b655e9

	measure Events = COUNTROWS ( Events )
		formatString: #,0
		lineageTag: 83af16e3-9791-5482-80fa-0b3d5bd3b770

	measure 'Events With Exact Date' = CALCULATE ( [Events], Events[Date Precision] = "day" )
		formatString: #,0
		lineageTag: d559815f-8d68-5c11-bb97-ac53584c66f8

	measure 'Events Date TBC' = CALCULATE ( [Events], Events[Date Status] = "TBC / Undated" )
		formatString: #,0
		lineageTag: 64ee856f-5fd9-58da-bc3c-925aa358f51f

	measure 'Exact Date %' = DIVIDE ( [Events With Exact Date], [Events] )
		formatString: 0%
		lineageTag: 1bb5a9a1-5b43-5a1d-be78-0d1525d679fd

	measure Countries = DISTINCTCOUNT ( Events[Country] )
		formatString: #,0
		lineageTag: 1d5bce13-b5d3-5941-9494-cd41f4509e25

	measure 'Events Starting' = CALCULATE ( [Events], Events[Date Precision] = "day" )
		formatString: 0
		lineageTag: e14a2a2a-9ee5-52ca-a957-b43ef8ecaa33

	measure 'Event Name' = SELECTEDVALUE ( Events[Event], "Several events" )
		lineageTag: 1d3d35dc-008e-5664-944b-4d40afe32c94

	measure 'Upcoming Events' = CALCULATE ( [Events], Events[Start Date] >= TODAY () )
		formatString: #,0
		lineageTag: c89cddd2-8e03-57d1-8e13-67f0644d6f9c

	measure 'Starts In' = VAR sd = SELECTEDVALUE ( Events[Start Date] ) VAR n = DATEDIFF ( TODAY (), sd, DAY ) RETURN SWITCH ( TRUE (), ISBLANK ( sd ), "date TBC", n < 0, "ended", n = 0, "today", n = 1, "tomorrow", n < 60, "in " & n & " days", "in " & ROUND ( n / 30.4, 0 ) & " months" )
		lineageTag: d83f842e-91a3-5e24-9692-e2dd3fdcdbc8

	measure 'KPI Sub Events' = "ASEAN " & FORMAT ( CALCULATE ( [Events], Events[Market] = "ASEAN" ) + 0, "#,0" ) & "  ·  US " & FORMAT ( CALCULATE ( [Events], Events[Market] = "US" ) + 0, "#,0" ) & "  ·  EU " & FORMAT ( CALCULATE ( [Events], Events[Market] = "Europe" ) + 0, "#,0" ) & "  ·  UK " & FORMAT ( CALCULATE ( [Events], Events[Market] = "UK" ) + 0, "#,0" )
		lineageTag: 28075422-248c-5d8f-884f-914b26e2ef16

	measure 'KPI Sub Countries' = VAR top1 = TOPN ( 1, VALUES ( Events[Country] ), [Events], DESC ) RETURN "most: " & MAXX ( top1, Events[Country] ) & " (" & FORMAT ( MAXX ( top1, [Events] ), "#,0" ) & ")"
		lineageTag: 60e9a721-1bc6-52a4-875f-aec038190bcd

	measure 'KPI Sub Exact' = FORMAT ( [Events With Exact Date] + 0, "#,0" ) & " events with an exact day"
		lineageTag: f20403ee-4a8c-5a4a-838d-f9b60c02cdfe

	measure 'KPI Sub TBC' = "month, year or no date announced yet"
		lineageTag: 848d7a39-72f5-5564-93f0-9eb81073fa35

	measure 'KPI Sub Next' = VAR nxt = TOPN ( 1, FILTER ( Events, Events[Start Date] >= TODAY () ), Events[Start Date], ASC ) RETURN IF ( ISEMPTY ( nxt ), "none scheduled", "next: " & MAXX ( nxt, Events[Event] ) )
		lineageTag: 202f78f5-4b55-53a6-a752-db45d750c057

	measure 'Busiest Month' = MAXX ( TOPN ( 1, VALUES ( 'Date'[Year Month] ), [Events Starting], DESC ), 'Date'[Year Month] )
		lineageTag: d1cf0469-7e43-5c47-b97f-867b6492a5b0

	measure 'KPI Sub Busiest' = FORMAT ( MAXX ( TOPN ( 1, VALUES ( 'Date'[Year Month] ), [Events Starting], DESC ), [Events Starting] ), "#,0" ) & " events start that month"
		lineageTag: 17a97e7d-3a20-5644-8d5f-c35603e1e69d

