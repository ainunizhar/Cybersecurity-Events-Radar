table Date
	dataCategory: Time
	lineageTag: 5912f59a-08ae-5c83-950a-e80607904284

	column Date
		dataType: dateTime
		formatString: dd mmm yyyy
		isKey
		lineageTag: 1db19198-9431-5d66-8ff3-fd5e32f8ecb5
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 8fea8e1e-1c48-556a-b974-bdec676e09e7
		summarizeBy: none
		sourceColumn: Year

	column 'Month No'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: d5d87642-5581-5744-a43d-03fbebbfd209
		summarizeBy: none
		sourceColumn: Month No

	column Month
		dataType: string
		lineageTag: 10ddacc9-2b7b-5f01-88ff-02021986c7b7
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: 'Month No'

	column 'Year Month Key'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: bd1a3752-c6cf-5226-b2c8-ec59b7e961c8
		summarizeBy: none
		sourceColumn: Year Month Key

	column 'Year Month'
		dataType: string
		lineageTag: a267de3c-64b1-5a9e-847e-d4d308275e4c
		summarizeBy: none
		sourceColumn: Year Month
		sortByColumn: 'Year Month Key'

	column Day
		dataType: int64
		formatString: 0
		lineageTag: 28ebdcfa-621e-5662-afbb-b791dd841e6c
		summarizeBy: none
		sourceColumn: Day

	column 'Weekday No'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 0409f682-32e8-5e2d-8533-fcd510537a5e
		summarizeBy: none
		sourceColumn: Weekday No

	column Weekday
		dataType: string
		lineageTag: 0808a36d-b529-536a-a7c4-542f6c0e62d8
		summarizeBy: none
		sourceColumn: Weekday
		sortByColumn: 'Weekday No'

	column Quarter
		dataType: string
		lineageTag: 3f43bbd2-450b-5845-a818-80d9eef2c3d3
		summarizeBy: none
		sourceColumn: Quarter

	partition Date = m
		mode: import
		source =
				let
				    StartDate = #date(2026, 1, 1),
				    EndDate = #date(2027, 12, 31),
				    Dates = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1, 0, 0, 0)),
				    AsTable = Table.FromList(Dates, Splitter.SplitByNothing(), {"Date"}),
				    Typed = Table.TransformColumnTypes(AsTable, {{"Date", type date}}),
				    AddYear = Table.AddColumn(Typed, "Year", each Date.Year([Date]), Int64.Type),
				    AddMonthNo = Table.AddColumn(AddYear, "Month No", each Date.Month([Date]), Int64.Type),
				    AddMonth = Table.AddColumn(AddMonthNo, "Month", each Date.ToText([Date], [Format = "MMMM", Culture = "en-GB"]), type text),
				    AddYearMonthKey = Table.AddColumn(AddMonth, "Year Month Key", each Date.Year([Date]) * 100 + Date.Month([Date]), Int64.Type),
				    AddYearMonth = Table.AddColumn(AddYearMonthKey, "Year Month", each Date.ToText([Date], [Format = "MMM yyyy", Culture = "en-GB"]), type text),
				    AddDay = Table.AddColumn(AddYearMonth, "Day", each Date.Day([Date]), Int64.Type),
				    AddWeekdayNo = Table.AddColumn(AddDay, "Weekday No", each Date.DayOfWeek([Date], Day.Monday) + 1, Int64.Type),
				    AddWeekday = Table.AddColumn(AddWeekdayNo, "Weekday", each Date.ToText([Date], [Format = "ddd", Culture = "en-GB"]), type text),
				    AddQuarter = Table.AddColumn(AddWeekday, "Quarter", each "Q" & Text.From(Date.QuarterOfYear([Date])), type text)
				in
				    AddQuarter

	annotation PBI_ResultType = Table
