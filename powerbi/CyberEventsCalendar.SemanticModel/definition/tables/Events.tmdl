	partition Events = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DataFolder & "Cyber_Events_2026_2027.xlsx"), null, true),
				    Sheet = Source{[Item = "Events", Kind = "Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars = true]),
				    Rows = Table.SelectRows(Promoted, each [Event Name] <> null and [Event Name] <> ""),
				    WithId = Table.AddIndexColumn(Rows, "Event ID", 1, 1, Int64.Type),
				    Typed = Table.TransformColumnTypes(WithId, {{"Dataset", type text}, {"Market", type text}, {"Category", type text}, {"Event Name", type text}, {"Country", type text}, {"City", type text}, {"Venue", type text}, {"Start (as written)", type text}, {"End (as written)", type text}, {"Year", type text}, {"Event Type", type text}, {"Focus", type text}, {"Organiser", type text}, {"Scale / Audience", type text}, {"MSSP Relevance", type text}, {"Source URL", type text}, {"Verification", type text}, {"Note", type text}, {"Start Date", type date}, {"End Date", type date}, {"Month", type text}, {"Date Precision", type text}, {"Date Status", type text}}),
				    PrecisionLabel = Table.AddColumn(Typed, "Date Precision Label", each
				        if [Date Precision] = "day" then "Exact day"
				        else if [Date Precision] = "month" then "Month only"
				        else if [Date Precision] = "year" then "Year only"
				        else "No date yet", type text)
				in
				    PrecisionLabel

	annotation PBI_ResultType = Table
